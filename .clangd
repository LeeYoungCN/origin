CompileFlags:
  CompilationDatabase: out/build

# 补全相关配置（控制代码提示和自动完成行为）
Completion:
  AllScopes: Yes
  ArgumentLists: FullPlaceholders

# 索引相关配置（控制代码索引构建和存储方式）
Index:
  Background: Build
  StandardLibrary: true

InlayHints:
  BlockEnd: false
  Designators: true     # 聚合初始化提示（如 { .name = "foo" }）
  Enabled: true         # 启用代码提示
  ParameterNames: true  # 函数参数名提示（如 func(a: int, b: float)）
  DeducedTypes: true        # 自动推断的类型提示（如 auto x /* = int */ = 5
  DefaultArguments: true
  TypeNameLimit: 24

Diagnostics:
  ClangTidy:
    FastCheckFilter: None
    Add:
      - performance-unnecessary-value-param
      - readability-braces-around-statements
      - bugprone-use-after-move
      - bugprone-unused-raii
      - bugprone-macro-parentheses
      - modernize-use-override
      - modernize-use-nullptr
      - modernize-use-equals-default
      - readability-const-return-type
    Remove:
      - readability-avoid-const-params-in-decls
      # 如果你不想某些规则报警，可以继续在这里减

  # 提示级别
  UnusedIncludes: Strict
  MissingIncludes: Strict

Hover:
  ShowAKA: true
  ShowDocumentation: true
