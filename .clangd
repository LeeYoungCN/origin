# .clangd
CompileFlags:
  CompilationDatabase: out/build      # script/check_tidy.sh 与 VS Code 会把当前 preset 的 compile_commands.json 复制到这里

Completion:
  AllScopes: Yes
  ArgumentLists: FullPlaceholders
  HeaderInsertion: IWYU               # 补全时按 IWYU 自动补齐所属头（原来是无效键）

Index:
  Background: Build

Diagnostics:
  UnusedIncludes: Strict           # 未使用 include（clangd 自带 Include Cleaner）
  MissingIncludes: Strict          # 缺失 include，与 CI 的 misc-include-cleaner 对齐
  ClangTidy:
    Add: []
    Remove:
      - misc-include-cleaner     # 编辑器用 clangd 自带 Include Cleaner，CI/脚本用 clang-tidy 的
    FastCheckFilter: Loose

InlayHints:
  Enabled: true
  BlockEnd: false
  Designators: true
  ParameterNames: true
  DeducedTypes: true
  DefaultArguments: true
  TypeNameLimit: 24

Hover:
  ShowAKA: true
