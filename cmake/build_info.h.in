#ifndef ORIGIN_BUILD_INFO_H
#define ORIGIN_BUILD_INFO_H

// 该文件由 cmake/build_info.h.in 生成，请勿手改。
//
// 开发版相关的版本信息（完整串 / 提交号 / 是否脏）单独成一个头文件：
// 它们随提交变化，放进 version.h 会让所有依赖版本头的编译单元重编。
// 这里只有 Common 的 version.cpp 引用它。

// 开发版完整版本串，形如 "1.0.1-dev+g7b4ef62-dirty"；发布构建等于 ORIGIN_VERSION_STRING
#define ORIGIN_VERSION_FULL "@ORIGIN_VERSION_FULL@"

// 开发版构建的短提交号；发布构建（tag）或没有 git 时为空
#define ORIGIN_VERSION_COMMIT "@ORIGIN_VERSION_COMMIT@"

// 非 0 表示开发版构建时工作区有未提交修改
#define ORIGIN_VERSION_DIRTY @ORIGIN_VERSION_DIRTY@

#endif  // ORIGIN_BUILD_INFO_H
