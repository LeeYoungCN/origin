# 本文件由 configure_summary.cmake 通过 configure_file 生成，随后被
# cmake_tools.sh 的 init_cmake_env() source 回填构建参数。
# 左侧变量名必须与 cmake_tools.sh 中的 shell 变量同名；重命名时两边同步修改，
# 否则 source 会写入错误变量，或把脚本已经算好的值清空。

# 构建配置
ARCHITECTURE="@ARCHITECTURE@"
cmake_configure_file="@CMAKE_CONFIGURE_FILE@"
cmake_preset="@CMAKE_PRESET@"
cmake_build_type="@CMAKE_BUILD_TYPE@"
cmake_generator="@CMAKE_GENERATOR@"
cmake_toolchain_file="@CMAKE_TOOLCHAIN_FILE@"
env_param_file="@ENV_PARAM_FILE@"

# 版本
origin_version="@ORIGIN_VERSION@"
origin_version_full="@ORIGIN_VERSION_FULL@"
origin_version_numeric="@ORIGIN_VERSION_NUMERIC@"

# 路径
project_source_dir="@PROJECT_SOURCE_DIR@"
cmake_source_dir="@CMAKE_SOURCE_DIR@"
cmake_binary_dir="@CMAKE_BINARY_DIR@"
cmake_install_prefix="@CMAKE_INSTALL_PREFIX@"
cpack_package_directory="@CPACK_PACKAGE_DIRECTORY@"
cmake_third_party_path="@CMAKE_THIRD_PARTY_PATH@"

# 功能开关
cmake_build_test="@ORIGIN_BUILD_TESTS@"
cmake_enable_asan="@ORIGIN_ENABLE_ASAN@"
cmake_install_rules="@ORIGIN_INSTALL@"

# 平台
cmake_system_name="@CMAKE_SYSTEM_NAME@"
cmake_system_processor="@CMAKE_SYSTEM_PROCESSOR@"
cmake_sizeof_void_p="@CMAKE_SIZEOF_VOID_P@"
cpu_cores="@CPU_CORES@"
cmake_version="@CMAKE_VERSION@"

# 编译器
cmake_c_compiler="@CMAKE_C_COMPILER@"
cmake_c_compiler_id="@CMAKE_C_COMPILER_ID@"
cmake_c_compiler_version="@CMAKE_C_COMPILER_VERSION@"
cmake_c_compiler_frontend_variant="@CMAKE_C_COMPILER_FRONTEND_VARIANT@"
cmake_cxx_compiler="@CMAKE_CXX_COMPILER@"
cmake_cxx_compiler_id="@CMAKE_CXX_COMPILER_ID@"
cmake_cxx_compiler_version="@CMAKE_CXX_COMPILER_VERSION@"
cmake_cxx_compiler_frontend_variant="@CMAKE_CXX_COMPILER_FRONTEND_VARIANT@"

# 编译/链接选项
cmake_c_flags="@CMAKE_C_FLAGS@"
cmake_c_flags_debug="@CMAKE_C_FLAGS_DEBUG@"
cmake_c_flags_release="@CMAKE_C_FLAGS_RELEASE@"
cmake_cxx_flags="@CMAKE_CXX_FLAGS@"
cmake_cxx_flags_debug="@CMAKE_CXX_FLAGS_DEBUG@"
cmake_cxx_flags_release="@CMAKE_CXX_FLAGS_RELEASE@"
cmake_exe_linker_flags="@CMAKE_EXE_LINKER_FLAGS@"
