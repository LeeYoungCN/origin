#ifndef ORIGIN_VERSION_H
#define ORIGIN_VERSION_H

// 该文件由 cmake/version.h.in 生成，请勿手改
#define ORIGIN_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define ORIGIN_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define ORIGIN_VERSION_PATCH @PROJECT_VERSION_PATCH@

// 完整版本字符串，形如 "1.0.0" 或预发布 "1.0.0-rc1"
#define ORIGIN_VERSION_STRING "@ORIGIN_VERSION@"

// 构建时间不在这里：见 origin/build_info.h（每次 configure 都会变，单独成文件避免全量重编）

#endif  // ORIGIN_VERSION_H
